{
  "name": "tellico-vscode",
  "displayName": "Tellico",
  "description": "Chat with the Tellico Qwen agents (opencode-tellico) inside VS Code.",
  "version": "0.3.0",
  "publisher": "yejashi",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/Yejashi/tellico-vscode"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat"
  ],
  "extensionKind": [
    "workspace"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished",
    "onWebviewPanel:tellico.chatTab"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "tellico",
          "title": "Tellico",
          "icon": "media/tellico.svg"
        }
      ]
    },
    "views": {
      "tellico": [
        {
          "type": "webview",
          "id": "tellico.chat",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "tellico.newSession",
        "title": "New Session",
        "category": "Tellico",
        "icon": "$(add)"
      },
      {
        "command": "tellico.openInTab",
        "title": "Open Chat in New Tab",
        "category": "Tellico",
        "icon": "$(link-external)"
      },
      {
        "command": "tellico.history",
        "title": "Session History",
        "category": "Tellico",
        "icon": "$(history)"
      },
      {
        "command": "tellico.focus",
        "title": "Focus Chat",
        "category": "Tellico"
      },
      {
        "command": "tellico.addSelection",
        "title": "Add Selection to Chat",
        "category": "Tellico"
      },
      {
        "command": "tellico.switchConnection",
        "title": "Switch Connection (SSH / Gateway)",
        "category": "Tellico",
        "icon": "$(plug)"
      },
      {
        "command": "tellico.setGatewayKey",
        "title": "Set Gateway API Key",
        "category": "Tellico",
        "icon": "$(key)"
      },
      {
        "command": "tellico.restartServer",
        "title": "Restart Server",
        "category": "Tellico"
      },
      {
        "command": "tellico.showLogs",
        "title": "Show Server Logs",
        "category": "Tellico"
      },
      {
        "command": "tellico.openChanges",
        "title": "Open Changed File Diff",
        "category": "Tellico"
      },
      {
        "command": "tellico.stats",
        "title": "Session Stats",
        "category": "Tellico",
        "icon": "$(pulse)"
      },
      {
        "command": "tellico.mcp",
        "title": "MCP Servers",
        "category": "Tellico",
        "icon": "$(plug)"
      },
      {
        "command": "tellico.mcpAdd",
        "title": "Add MCP Server\u2026",
        "category": "Tellico",
        "icon": "$(add)"
      },
      {
        "command": "tellico.mcpImport",
        "title": "Import MCP Servers from VS Code\u2026",
        "category": "Tellico"
      },
      {
        "command": "tellico.compact",
        "title": "Compact Conversation",
        "category": "Tellico",
        "icon": "$(fold)"
      },
      {
        "command": "tellico.stop",
        "title": "Stop the Running Turn",
        "category": "Tellico",
        "icon": "$(debug-stop)"
      },
      {
        "command": "tellico.explainSelection",
        "title": "Explain Selection",
        "category": "Tellico"
      },
      {
        "command": "tellico.fixProblems",
        "title": "Fix Problems in This File",
        "category": "Tellico"
      },
      {
        "command": "tellico.sendTerminalSelection",
        "title": "Send Terminal Selection to Chat",
        "category": "Tellico"
      },
      {
        "command": "tellico.sendLastTerminalCommand",
        "title": "Send Last Terminal Command to Chat",
        "category": "Tellico"
      },
      {
        "command": "tellico.openSettings",
        "title": "Open Settings",
        "category": "Tellico",
        "icon": "$(settings-gear)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "tellico.newSession",
          "when": "view == tellico.chat",
          "group": "navigation@1"
        },
        {
          "command": "tellico.history",
          "when": "view == tellico.chat",
          "group": "navigation@2"
        },
        {
          "command": "tellico.openInTab",
          "when": "view == tellico.chat",
          "group": "navigation@3"
        },
        {
          "command": "tellico.mcp",
          "when": "view == tellico.chat",
          "group": "1_tools@1"
        },
        {
          "command": "tellico.stats",
          "when": "view == tellico.chat",
          "group": "1_tools@2"
        },
        {
          "command": "tellico.compact",
          "when": "view == tellico.chat",
          "group": "1_tools@3"
        },
        {
          "command": "tellico.switchConnection",
          "when": "view == tellico.chat",
          "group": "2_server@1"
        },
        {
          "command": "tellico.restartServer",
          "when": "view == tellico.chat",
          "group": "2_server@2"
        },
        {
          "command": "tellico.showLogs",
          "when": "view == tellico.chat",
          "group": "2_server@3"
        },
        {
          "command": "tellico.openSettings",
          "when": "view == tellico.chat",
          "group": "3_settings@1"
        }
      ],
      "editor/context": [
        {
          "command": "tellico.addSelection",
          "when": "editorHasSelection",
          "group": "tellico@1"
        },
        {
          "command": "tellico.explainSelection",
          "when": "editorHasSelection && resourceScheme == file",
          "group": "tellico@2"
        },
        {
          "command": "tellico.fixProblems",
          "when": "resourceScheme == file",
          "group": "tellico@3"
        }
      ],
      "commandPalette": [
        {
          "command": "tellico.openChanges",
          "when": "false"
        },
        {
          "command": "tellico.explainSelection",
          "when": "editorHasSelection"
        },
        {
          "command": "tellico.sendTerminalSelection",
          "when": "terminalTextSelected"
        }
      ],
      "terminal/context": [
        {
          "command": "tellico.sendTerminalSelection",
          "when": "terminalTextSelected",
          "group": "tellico@1"
        },
        {
          "command": "tellico.sendLastTerminalCommand",
          "group": "tellico@2"
        }
      ]
    },
    "keybindings": [
      {
        "command": "tellico.focus",
        "key": "ctrl+escape",
        "mac": "cmd+escape"
      },
      {
        "command": "tellico.openInTab",
        "key": "ctrl+shift+escape",
        "mac": "cmd+shift+escape"
      },
      {
        "command": "tellico.addSelection",
        "key": "alt+k",
        "when": "editorTextFocus"
      },
      {
        "command": "tellico.stop",
        "key": "ctrl+alt+escape",
        "mac": "cmd+alt+escape",
        "when": "tellico.busy"
      }
    ],
    "configuration": {
      "title": "Tellico",
      "properties": {
        "tellico.launcherPath": {
          "type": "string",
          "default": "opencode-tellico",
          "description": "The opencode-tellico launcher from tellico-agentic-setup. A bare name is looked up on PATH and in ~/.local/bin."
        },
        "tellico.connection": {
          "type": "string",
          "enum": [
            "installed",
            "tunnel",
            "gateway"
          ],
          "default": "installed",
          "enumDescriptions": [
            "Whatever ./install.sh set up on this device.",
            "Over your own SSH connection to the cluster (needs a cluster account).",
            "Through the API gateway with your per-user key (no SSH). Set the key with \"Tellico: Set Gateway API Key\"."
          ],
          "description": "How the extension reaches the Tellico models. Each connection keeps its own key, so you can switch freely."
        },
        "tellico.gatewayUrl": {
          "type": "string",
          "default": "",
          "description": "Gateway base URL for the gateway connection, e.g. https://host/v1. Empty uses the one install.sh recorded."
        },
        "tellico.leadNode": {
          "type": "string",
          "enum": [
            "auto",
            "0",
            "1"
          ],
          "default": "auto",
          "description": "Which Tellico server new sessions lead on. auto derives a stable node from this device, as opencode-tellico does."
        },
        "tellico.defaultMode": {
          "type": "string",
          "enum": [
            "build",
            "orchestrate"
          ],
          "default": "build",
          "enumDescriptions": [
            "build-tellico: one engineer does the whole job on one server.",
            "orchestrate-tellico: the same engineer, which may also delegate to the two node-pinned workers."
          ],
          "description": "Agent new sessions open on."
        },
        "tellico.defaultThink": {
          "type": "string",
          "enum": [
            "off",
            "low",
            "medium",
            "xhigh"
          ],
          "default": "medium",
          "description": "Thinking level new sessions start with."
        },
        "tellico.magicContext": {
          "type": "boolean",
          "default": true,
          "description": "Use Magic Context instead of OpenCode's compaction (opencode-tellico --no-magic-context when off)."
        },
        "tellico.backgroundSubagents": {
          "type": "boolean",
          "default": false,
          "description": "Dispatch workers in the background (TELLICO_BACKGROUND_SUBAGENTS=1). Off, like the launcher: the lead waits for each worker's report, which the model tracks far more reliably."
        },
        "tellico.attachActiveEditor": {
          "type": "boolean",
          "default": true,
          "description": "Attach the active file (and selection, if any) to each prompt."
        },
        "tellico.showReasoning": {
          "type": "boolean",
          "default": false,
          "description": "Expand the model's reasoning blocks by default."
        },
        "tellico.smoothStreaming": {
          "type": "boolean",
          "default": true,
          "description": "Reveal streamed text at a steady pace, like a chat app, instead of showing each cluster of tokens as it arrives. Works the same over SSH and the gateway."
        },
        "tellico.ideTools": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "Run a small MCP server named `vscode` that lets the agent ask VS Code for **diagnostics**, **open editors** and the **selection**. Loopback only, with a per-window token. Its three tools add a few hundred tokens to each request."
        },
        "tellico.codeActions": {
          "type": "boolean",
          "default": true,
          "description": "Offer \"Fix with Tellico\" on problems and \"Explain with Tellico\" on selections in the lightbulb menu."
        },
        "tellico.notifications": {
          "type": "string",
          "enum": [
            "unfocused",
            "always",
            "off"
          ],
          "default": "unfocused",
          "enumDescriptions": [
            "Only while VS Code is in the background.",
            "Every time.",
            "Never."
          ],
          "description": "Notify when a turn finishes or Tellico is waiting for an answer."
        },
        "tellico.websearch": {
          "type": "string",
          "enum": [
            "default",
            "tavily",
            "exa",
            "parallel",
            "random",
            "off"
          ],
          "default": "default",
          "description": "Web search provider for the agents (TELLICO_WEBSEARCH). default leaves the launcher's choice; off removes the tool."
        },
        "tellico.steps": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "description": "Maximum model steps per turn for the lead agents (TELLICO_STEPS). 0 leaves the launcher's default (200)."
        },
        "tellico.loopGuard": {
          "type": "boolean",
          "default": true,
          "description": "Let the loop guard interrupt a reply that starts repeating itself (TELLICO_LOOP_GUARD=0 when off)."
        },
        "tellico.remoteControl": {
          "type": "string",
          "enum": [
            "installed",
            "on",
            "off"
          ],
          "default": "installed",
          "description": "Phone remote control for sessions in this window (opencode-tellico --[no-]remote-control). installed follows ./install.sh."
        }
      }
    },
    "walkthroughs": [
      {
        "id": "tellico.start",
        "title": "Get started with Tellico",
        "description": "Chat with the Tellico Qwen agents on your cluster, inside VS Code.",
        "steps": [
          {
            "id": "connect",
            "title": "Choose how to reach the cluster",
            "description": "Use your SSH account, or the API gateway with a per-user key.\n[Switch Connection](command:tellico.switchConnection)\n[Set Gateway API Key](command:tellico.setGatewayKey)",
            "media": {
              "markdown": "media/walkthrough/connect.md"
            },
            "completionEvents": [
              "onCommand:tellico.switchConnection",
              "onCommand:tellico.setGatewayKey"
            ]
          },
          {
            "id": "chat",
            "title": "Open the chat",
            "description": "Ask Tellico to build, fix or explain. @ mentions files, ! runs a command, / lists commands.\n[Open Tellico](command:tellico.focus)",
            "media": {
              "markdown": "media/walkthrough/chat.md"
            },
            "completionEvents": [
              "onCommand:tellico.focus"
            ]
          },
          {
            "id": "rewind",
            "title": "Rewind, edit or fork any message",
            "description": "Hover a message you sent to restore the files and conversation to before it, edit and resend it, or branch a new session from there.",
            "media": {
              "markdown": "media/walkthrough/rewind.md"
            }
          },
          {
            "id": "mcp",
            "title": "Give the agent more tools (MCP)",
            "description": "Tellico already asks VS Code for diagnostics. Add MCP servers, or import the ones VS Code knows.\n[MCP Servers](command:tellico.mcp)",
            "media": {
              "markdown": "media/walkthrough/mcp.md"
            },
            "completionEvents": [
              "onCommand:tellico.mcp"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p webview",
    "test": "vitest run",
    "package": "npm run build -- --production && vsce package --no-dependencies",
    "vscode:prepublish": "node esbuild.mjs --production",
    "preview": "node esbuild.mjs && node scripts/preview/build.mjs",
    "test:vscode": "node esbuild.mjs && node scripts/vscode-smoke.mjs",
    "test:live": "TELLICO_LIVE=1 vitest run test/live.test.ts"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@types/vscode": "~1.95.0",
    "@vscode/codicons": "^0.0.36",
    "@vscode/vsce": "^3.2.1",
    "dompurify": "^3.2.4",
    "esbuild": "^0.24.2",
    "highlight.js": "^11.12.0",
    "jsonc-parser": "^3.3.1",
    "marked": "^15.0.6",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  }
}
